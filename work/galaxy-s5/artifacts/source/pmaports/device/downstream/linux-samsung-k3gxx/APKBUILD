# Archived: Kernel does not build anymore
# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm/configs/lineage_k3gxx_defconfig

maintainer=""
pkgname=linux-samsung-k3gxx
pkgver=3.10.9
pkgrel=1
pkgdesc="Samsung Galaxy S5 (International 3G) kernel fork"
arch="armv7"
_carch="arm"
_flavor="samsung-k3gxx"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	devicepkg-dev
	dtbtool-exynos
	flex
	openssl-dev
	perl
	linux-headers
"

# Source
_repository="android_kernel_samsung_k3gxx"
_commit="2f78dde45cd08d9f1f7f047c81ffb237f7ab9b56"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/LineageOS/$_repository/archive/$_commit.tar.gz
	$_config
	gcc7-give-up-on-ilog2-const-optimizations.patch
	gcc8-fix-put-user.patch
	gcc10-extern_YYLOC_global_declaration.patch
	binutils-2.45-section-flags.patch
	gcc15-fips-helper-declarations.patch
	preserve-r11-in-cpu-v7-suspend.patch
"
builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare
	. downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KCFLAGS="-std=gnu89" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"

	# Master DTB (deviceinfo_bootimg_qcdt)
	# Match the SM-G900H bootloader's DTBH platform/subtype IDs.
	dtbTool-exynos --platform 0x1e92 --subtype 0x7d64f612 \
		-o "$_outdir/arch/$_carch/boot"/dt.img \
		$(find "$_outdir/arch/$_carch/boot/dts/" -name *k3g*.dtb)
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"
	install -Dm644 "$_outdir/arch/$_carch/boot"/dt.img \
		"$pkgdir"/boot/dt.img
}

