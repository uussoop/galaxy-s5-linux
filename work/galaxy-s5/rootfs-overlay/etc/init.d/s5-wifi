#!/sbin/openrc-run

description="Connect the Galaxy S5 to saved Wi-Fi when a profile is installed"

depend() {
	need localmount
	after s5-wifi-init sshd
}

start() {
	local profile=/etc/wpa_supplicant/wpa_supplicant.conf
	if [ ! -s "$profile" ]; then
		einfo "No Wi-Fi profile installed; skipping wireless connection"
		return 0
	fi
	ebegin "Starting Galaxy S5 Wi-Fi"
	if [ ! -e /sys/class/net/wlan0 ]; then
		eend 1 "wlan0 is unavailable"
		return 1
	fi
	ip link set wlan0 up || return 1
	wpa_supplicant -B -P /run/s5-wpa_supplicant.pid \
		-i wlan0 -D nl80211 -c "$profile" || return 1
	udhcpc -b -i wlan0 -p /run/s5-udhcpc.pid \
		-s /usr/share/udhcpc/default.script
	eend $?
}

stop() {
	ebegin "Stopping Galaxy S5 Wi-Fi"
	start-stop-daemon --stop --quiet --pidfile /run/s5-udhcpc.pid || :
	start-stop-daemon --stop --quiet --pidfile /run/s5-wpa_supplicant.pid || :
	eend 0
}
